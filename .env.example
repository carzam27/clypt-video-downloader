# Path to the yt-dlp binary.
# Leave blank to use 'yt-dlp' from PATH (default when installed globally).
# Example for a local install: YTDLP_PATH=/usr/local/bin/yt-dlp
YTDLP_PATH=

# Base path for the app when running behind a sub-path proxy (e.g. /clypt-next).
# Leave blank for Vercel / root-domain deployments.
BASE_PATH=

# Automatically derived from BASE_PATH — do not set manually.
# NEXT_PUBLIC_BASE_PATH=

# Secret for POST /api/videos/quick (iOS Shortcuts). The endpoint is disabled until this is set.
# Generate one with: openssl rand -hex 24
CLYPT_API_TOKEN=

# Logged-in cookies for sites that block the server IP (Instagram, YouTube).
# Content of a Netscape cookies.txt, raw or base64 (macOS: base64 -i cookies.txt | pbcopy).
# Treat it like a password: it grants access to that account.
CLYPT_COOKIES=
